# 数据库配置
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=info_management
DB_PORT=3306

# JWT 密钥（请生成强密钥）
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_EXPIRES_IN=30d

# 服务器配置
PORT=3003
NODE_ENV=production

# CORS 配置（生产环境请设置具体域名）
CORS_ORIGIN=https://www.yiban.asia

# 阿里云短信服务
ALIYUN_SMS_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_SMS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_SMS_SIGN_NAME=your-sign-name
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_TEMPLATE_REGISTER=100001
ALIYUN_SMS_TEMPLATE_LOGIN=100001
ALIYUN_SMS_TEMPLATE_RESET=100003

# 邮箱服务
EMAIL_USER=your-email@qq.com
EMAIL_PASS=your-email-auth-code

# 微信小程序 - 有指南小程序
WECHAT_APPID=your-wechat-appid-1
WECHAT_SECRET=your-wechat-secret-1

# 微信小程序 - 有壹有伴小程序
WECHAT_APPID_2=your-wechat-appid-2
WECHAT_SECRET_2=your-wechat-secret-2

# 高德地图
GAODE_API_KEY=your-gaode-api-key

# 火山方舟 AI（豆包）
ARK_API_KEY=your-ark-api-key
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_MODEL=doubao-seed-2-0-lite-260215
ARK_VISION_MODEL=doubao-seed-1-6-vision-250815

# AI 加密密钥
AI_ENCRYPTION_KEY=your-ai-encryption-key-min-32-chars

# 公共域名
PUBLIC_ORIGIN=https://www.yiban.asia
