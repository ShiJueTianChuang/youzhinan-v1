.action-btn {
  flex: 1;
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  border: none;
  border-radius: 0;
  padding: 0;
  margin: 0;
  background: transparent;
  transition: all 0.3s ease;
}

.action-btn::after {
  border: none;
}

.cancel-btn {
  color: #999;
  border-right: 1rpx solid #f5f5f5;
}

.confirm-btn {
  color: #1E88E5;
  font-weight: 600;
}

.modal-footer {
  padding: 20rpx 0 40rpx;
  text-align: center;
  border-top: 1rpx solid #f5f5f5;
}

.logout-link {
  font-size: 26rpx;
  color: #ff4d4f;
  display: inline-block;
  padding: 10rpx 40rpx;
  opacity: 0.8;
}

.logout-link:active {
  opacity: 1;
  text-decoration: underline;
}
