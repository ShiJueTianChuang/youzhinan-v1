}

.input-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  text-align: right;
  padding-right: 10rpx;
}

.wechat-nickname-section {
  margin-top: 20rpx;
}

.section-divider {
  display: flex;
  align-items: center;
  margin: 30rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e9ecef;
}

.divider-text {
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #999;
}



.wechat-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.modal-actions {
