/* 调试面板相关样式 (已移除) */


/* 分隔线样式 */
.section-divider {
  height: 2rpx;
  background-color: #eee;
  margin: 20rpx 0;
}

/* 地址簿样式 */
.address-book {
  background: #ffffff;
  border-radius: 15rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: visible; /* 改为visible避免内容被裁剪 */
  border: 1rpx solid #e0e0e0;
}

.selector-title {
  font-size: 26rpx;
  margin-bottom: 8rpx; /* 减小标题下方间距 */
  color: #333;
  font-weight: 600;
  position: relative;
  padding: 0;
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  border: none;
  display: block;
  transition: none;
}

/* 分类选择滚动区域 */
.category-scroll, .province-scroll, .city-scroll {
  white-space: nowrap;
  padding: 5rpx 0; /* 减小上下内边距 */
  background: transparent;
  border-radius: 0;
  margin: 0 0 10rpx 0; /* 减小区域间距 */
  box-shadow: none;
  border: none;
  overflow-x: auto;
  overflow-y: hidden;
  position: relative;
  min-height: 70rpx;
}

.category-item, .province-item, .city-item {
  display: inline-block;
  padding: 10rpx 20rpx;
  margin-right: 15rpx;
  margin-bottom: 10rpx;
  background: #f5f5f5;
  border-radius: 50rpx;
  font-size: 24rpx;
  color: #666;
  font-weight: normal;
  transition: all 0.3s ease;
  box-shadow: none;
  border: 1rpx solid #e0e0e0;
  position: relative;
  overflow: hidden;
  cursor: pointer;
}

.category-item.active, .province-item.active, .city-item.active {
  background: #1E88E5;
  color: white;
  box-shadow: none;
  border: 1rpx solid #1E88E5;
  transform: none;
  z-index: 1;
  cursor: default;
}

/* 酒吧列表样式 */
.bar-list {
  background: #ffffff;
  border-radius: 15rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
  border: 1rpx solid #e0e0e0;
}

.list-title {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 600;
}

.bar-item {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  min-height: 220rpx;
  align-items: flex-start;
  transform: translateZ(0);
  backface-visibility: hidden;
}

.bar-item:last-child {
  border-bottom: none;
}

/* 酒吧图片样式 - 放在左边 */
.bar-image-container {
  position: relative;
  width: 160rpx; /* 稍微缩小图片尺寸 */
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.bar-image {
  width: 100%;
  height: 100%;
  display: block;
  background-color: #f0f0f0;
}

.bar-info {
  flex: 1;
  min-width: 0;
  padding-right: 10rpx;
  overflow: hidden; /* 防止内容溢出 */
}

.bar-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  line-height: 1.4;
  width: 100%;
}

.bar-distance {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  margin-bottom: 8rpx;
  padding: 4rpx 12rpx;
  max-width: 100%;
  background: #f4f6f9;
  border: 1rpx solid #e2e8f0;
  border-radius: 8rpx;
  box-sizing: border-box;
  animation: distance-fade-in 0.3s ease-out;
}

.distance-text {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
  white-space: nowrap;
  letter-spacing: 0.02em;
}

@keyframes distance-fade-in {
  from {
    opacity: 0;
    transform: translateY(-4rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.bar-category-tag {
  font-size: 24rpx;
  color: white;
  background: #1E88E5;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  white-space: nowrap;
  font-weight: 500;
}

.bar-address {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
  line-height: 1.4;
  word-wrap: break-word;
  word-break: break-all;
  white-space: normal;
  max-height: 68rpx; /* 最多显示两行 */
  overflow: hidden;
  flex-shrink: 0; /* 防止被压缩 */
}

.bar-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 5rpx;
  min-height: 50rpx; /* 确保有足够空间 */
}

.bar-tag {
  padding: 6rpx 16rpx;
  background-color: #1E88E5;
  color: white;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* 收藏按钮样式 */
.favorite-btn {
  font-size: 36rpx;
  padding: 0;
  border-radius: 50%;
  background-color: transparent;
  box-shadow: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 50rpx;
  min-height: 50rpx;
  transition: all 0.2s ease;
  margin-left: 10rpx;
  border: none;
  color: #ccc;
}

.favorite-btn.favorited {
  color: #ff4d4f;
  background-color: transparent;
  transform: scale(1.1);
}

/* 图片占位符样式 */
.bar-image-placeholder {
  width: 200rpx;
  height: 200rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 服务器状态提示样式 */
.server-status {
  margin: 40rpx 20rpx;
  padding: 40rpx;
  background-color: #fff8e1;
  border-radius: 16rpx;
  border-left: 8rpx solid #ff9800;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.server-error {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.error-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.error-text {
  font-size: 30rpx;
  color: #d32f2f;
  font-weight: bold;
  flex: 1;
}

.server-tips {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.server-tips text {
  display: block;
  font-size: 26rpx;
  color: #616161;
  margin-bottom: 15rpx;
  padding-left: 20rpx;
  position: relative;
}

.server-tips text:before {
  content: "•";
  position: absolute;
  left: 0;
  color: #1E88E5;
}

.retry-btn {
  background-color: #1E88E5;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 40rpx;
  font-size: 30rpx;
  font-weight: bold;
  width: 100%;
  box-shadow: 0 4rpx 12rpx rgba(30, 136, 229, 0.3);
  transition: all 0.3s ease;
}

.retry-btn:active {
  background-color: #1565c0;
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 6rpx rgba(30, 136, 229, 0.2);
}

/* 结果容器样式 */
.results-container {
  margin-top: 20rpx;
}

.no-results, .no-data {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
  background: #fff;
  border-radius: 15rpx;
  border: 1rpx solid #e0e0e0;
}

.favorite-btn-wrapper {
  padding: 10rpx;
