<!-- favorites.wxml -->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="nav-bar" style="height: {{expandedNavBarHeight}}px;">
    <view class="nav-back-btn" bindtap="goBack">
      <text class="back-icon">〈</text>
    </view>
    <view class="nav-title">我的收藏</view>
    <view class="nav-right"></view>
  </view>

  <!-- 主体内容 -->
  <view class="main-content" style="margin-top: {{expandedNavBarHeight}}px;">
    <!-- 收藏列表 -->
    <view class="bar-list">
      <view class="bar-item" wx:for="{{favoriteBars}}" wx:key="id" bindtap="goToDetail" data-index="{{index}}">
        <view class="bar-image-container">
          <image 
            class="bar-image" 
            src="{{item.listImage || item.image}}" 
            mode="aspectFill" 
            lazy-load="{{true}}"
            webp="{{true}}"
            binderror="onImageError" 
            data-index="{{index}}"
          ></image>
          <view wx:if="{{item.imageError || !item.image}}" class="bar-image-placeholder-overlay">
            <text>暂无图片</text>
          </view>
        </view>
        
        <view class="bar-info">
          <view class="bar-header-row">
            <view class="bar-name">{{item.name}}</view>
            <view class="bar-rating" wx:if="{{item.rating}}">
              <text class="rating-value">{{item.rating}}</text>
            </view>
          </view>
          
          <!-- 距离信息 -->
          <view class="bar-distance" wx:if="{{item.distanceText}}">
            <text class="distance-text">距您约 {{item.distanceText}}</text>
          </view>
          
          <!-- 地址 -->
          <view class="bar-address-row">
            <view class="bar-address" catchtap="openLocation" data-index="{{index}}">
              <image class="location-icon" src="/images/导航-01.png" mode="aspectFit"></image>
              <text class="location-text">{{item.province}}{{item.city}}{{item.district}}{{item.address}}</text>
            </view>
            <view class="action-btns">
              <view class="nav-btn" catchtap="openLocation" data-index="{{index}}">
                <image class="nav-btn-img" src="/images/导航-01.png"></image>
              </view>
              <view class="copy-btn" catchtap="copyAddress" data-index="{{index}}">
                <text class="copy-btn-text">复制</text>
              </view>
            </view>
          </view>
          
          <view class="bar-footer">
            <view class="bar-category-tag" wx:if="{{item.categoryType}}">{{item.categoryType}}</view>
            <view class="favorite-btn-wrapper" catchtap="toggleFavorite" data-index="{{index}}">
              <button class="favorite-btn favorited">❤️</button>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 如果没有数据 -->
      <view class="no-data" wx:if="{{favoriteBars.length === 0}}">
        <text>暂无收藏信息</text>
        <text style="display: block; font-size: 24rpx; color: #999; margin-top: 20rpx;">快去首页收藏喜欢的场所吧！</text>
      </view>
    </view>
  </view>
</view>
