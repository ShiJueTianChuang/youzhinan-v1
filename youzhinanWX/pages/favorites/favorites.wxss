/* favorites.wxss */

.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 导航栏样式 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #1E88E5;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 30rpx 40rpx;
  box-sizing: border-box;
  z-index: 99;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  transform: translateZ(0);
  backface-visibility: hidden;
}

.nav-back-btn {
  position: absolute;
  left: 30rpx;
  top: 60%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px 8px;
  border-radius: 4px;
  width: 32px;
  height: 32px;
  z-index: 10;
}

.back-icon {
  font-size: 18px;
  font-weight: normal;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 16px;
  font-weight: 500;
  color: white;
  text-align: center;
  line-height: 1.5;
  flex: 1;
  margin-top: 30rpx;
}

.nav-right {
  position: absolute;
  right: 30rpx;
  top: 60%;
  transform: translateY(-50%);
  min-width: 40px;
  height: 40px;
  z-index: 10;
}

/* 主体内容 */
.main-content {
  flex: 1;
  padding: 15px;
  padding-top: 0;
  margin-bottom: 160rpx;
  padding-bottom: 0;
  box-sizing: border-box;
}

.bar-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 10rpx;
}

.bar-item {
  background-color: white;
  border-radius: 15rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  align-items: flex-start;
  border: 1rpx solid #e0e0e0;
}

.bar-image-container {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.bar-image {
  width: 100%;
  height: 100%;
  display: block;
  background-color: #f5f5f5;
}

.bar-image-placeholder-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #bbbbbb;
  font-size: 20rpx;
  border-radius: 12rpx;
  z-index: 1;
}

.bar-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}

.bar-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.bar-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-rating {
  display: flex;
  align-items: center;
  margin-left: 10rpx;
}

.rating-value {
  font-size: 24rpx;
  font-weight: bold;
  color: #ff9800;
}

.bar-distance {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  margin-bottom: 8rpx;
  padding: 4rpx 12rpx;
  max-width: 100%;
  background: #f4f6f9;
  border: 1rpx solid #e2e8f0;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.distance-text {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
  white-space: nowrap;
  letter-spacing: 0.02em;
}

.bar-address {
  display: flex;
  align-items: flex-start;
  flex: 1;
  color: #999;
  font-size: 24rpx;
}

.bar-address-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 15rpx;
}

.location-icon {
  margin-right: 8rpx;
  width: 28rpx;
  height: 28rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.location-text {
  flex: 1;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.action-btns {
  display: flex;
  gap: 10rpx;
  margin-left: 10rpx;
}

.nav-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn-img {
  width: 100%;
  height: 100%;
}

.copy-btn {
  padding: 4rpx 12rpx;
  background-color: #1E88E5;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
}

.copy-btn-text {
  font-size: 22rpx;
  color: white;
}

.bar-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.bar-category-tag {
  font-size: 22rpx;
  color: white;
  background: #1E88E5;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  white-space: nowrap;
  font-weight: 500;
}

.favorite-btn-wrapper {
  padding: 10rpx;
  margin: -10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.favorite-btn {
  font-size: 36rpx;
  padding: 0;
  background-color: transparent;
  border: none;
  color: #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 50rpx;
  min-height: 50rpx;
}

.favorite-btn.favorited {
  color: #ff4d4f;
}

/* 暂无数据提示 */
.no-data {
  text-align: center;
  color: #999;
  padding: 40px 0;
  font-size: 14px;
}
