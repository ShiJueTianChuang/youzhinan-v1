.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: white;
  display: flex;
  padding: 0 20rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.06);
  z-index: 9999;
  border-top: 1px solid #f5f5f5;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
}

.tab-bar-border {
  background-color: rgba(0, 0, 0, 0.1);
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 1px;
  transform: scaleY(0.5);
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  min-height: 120rpx;
  padding: 12rpx 0;
  position: relative;
  z-index: 100;
  transition: all 0.2s ease;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 6rpx;
  display: block;
  transition: transform 0.2s ease;
}

.tab-bar-item .tab-text {
  font-size: 22rpx;
  margin-top: 4rpx;
  color: #666666;
  font-weight: 450;
  transition: color 0.2s ease;
}

/* 选中状态样式 */
.tab-bar-item.active .tab-text {
  color: #007aff;
  font-weight: 450;
}

.tab-bar-item.active .tab-icon {
  transform: scale(1);
}



/* 轻微的悬停效果 */
.tab-bar-item:active {
  background-color: rgba(0, 0, 0, 0.02);
}
